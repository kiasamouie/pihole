# Secrets — never commit
.env
secrets/

# Pi-hole runtime state (config, gravity DB, query log)
etc-pihole/

# Raw captures and bulky artifacts
reports/raw/*.pcap
*.pcap

# TVGuard session captures (runtime data, can be large)
captures/

# Legacy machine-config path (machine config now lives in .env; kept ignored for old checkouts)
config/tvguard.conf

# Local scratch
*.tmp
.DS_Store
reports/raw/ra-capture-*.txt

# Generated privacy-policy resolution data (ephemeral live IPs - re-resolve on demand)
data/privacy-policy/

# Offline-reconnect experiment output (runtime captures)
data/offline-reconnect/

# Manufacturer unknown-egress review data (runtime, contains live query detail)
data/manufacturer-unknown/

# Mined raw DNS history + resolution scratch (contains raw query logs - never commit)
research/tmp/
research/tmp-lg/
reports/raw/lan-refresh-*/

# Python bytecode
__pycache__/
*.pyc
