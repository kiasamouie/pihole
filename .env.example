#
# .env.example - TVGuard + Pi-hole machine configuration (the ONLY machine-specific file).
#
# Copy this to .env in the repo root (chmod 600), or just run `sudo ./bootstrap.sh`
# which creates .env, generates the admin password and fills in the host facts
# it can discover (LAN interface, subnet, box IP, upstream router).
#
# What belongs here:
#   * the host/network facts (interfaces, IPs, router)
#   * the TV target lists (which IPs TVGuard routes, which vendor gets privacy policy)
#   * the Pi-hole admin password
#
# What does NOT belong here: the privacy policies. They are network-independent
# and live in config/ (tracked). Never commit .env.

# --- Pi-hole -----------------------------------------------------------------
# Container timezone (any IANA zone, e.g. UTC)
TZ=UTC
# FTL admin password (bootstrap generates a random one; record it)
ADMIN_PASSWORD=
# Host IP the Pi-hole ports (53/tcp+udp, 3001, 3443) are published on.
# Bootstrap fills this with the box's LAN IP. Compose requires an explicit
# value so a blank/migrated config cannot expose Pi-hole on every interface.
# Loopback is additionally bound for the local web API only.
PIHOLE_BIND_IP=

# --- TVGuard deployment mode ---------------------------------------------------
# onearm-poc       : this box sits on the LAN; the upstream router stays router+DHCP
# dualnic-gateway  : this box IS the router (WAN_INTERFACE set, see below)
MODE=onearm-poc

# LAN side (the home network this box plugs into)
LAN_INTERFACE=
LAN_SUBNET=

# This host's LAN IP: the gateway/DNS address the TVs are pointed at.
GATEWAY_IP=
# Usually the same as GATEWAY_IP (one-arm mode).
PIHOLE_IP=

# Upstream toward the Internet (stays the router and the DHCP server).
UPSTREAM_ROUTER=

# dualnic-gateway only: the WAN-facing interface (empty for onearm-poc).
WAN_INTERFACE=

# --- TVs -----------------------------------------------------------------------
# Space-separated IPv4 addresses of every TV that uses this box as gateway/DNS.
# Only these source IPs are ever touched by TVGuard; all other LAN devices
# are byte-for-byte unaffected.
TVS=""

# Per-vendor privacy scope. Every address here must ALSO be in TVS, and an
# address may appear in only ONE vendor list. An empty list = that vendor's
# privacy policy is inactive (nothing is applied for it).
SAMSUNG_TVS=""
LG_TVS=""
GOOGLE_TVS=""

# Legacy single-TV keys (still honoured by the tooling if the *_TVS lists
# above are empty): SAMSUNG_IP, LG_IP, GOOGLE_TV_IP
