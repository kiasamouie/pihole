[Unit]
# TVGuard - re-apply the one-arm TV egress ruleset at boot.
# Only runs when the "active" marker is present (set by the enable scripts,
# removed by tvguard-disable.sh), so a disabled install stays off after reboot.
Description=TVGuard one-arm TV egress policy (nftables table ip tvguard)
# Wait for Docker, then verify that Pi-hole is healthy and mounted from this
# repository before resolving its bridge IP for DNS-bypass DNAT. Bootstrap
# atomically points these fixed launchers at the current repository clone.
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/var/lib/tvguard/active

[Service]
Type=oneshot
RemainAfterExit=yes
# Refuse to load against a missing database or a container bound to a stale
# repository path. The bounded gate re-attaches a Pi-hole that Docker left
# detached (docker-lan-heal) and proves the complete LAN DNS endpoint.
ExecStartPre=/usr/local/libexec/tvguard/pihole-boot-ready
# Re-applies the mode recorded in the state file (monitor/enforce). Idempotent.
# (No ExecStop: disabling is done explicitly via scripts/tvguard-disable.sh to
#  avoid systemd re-entrancy.)
ExecStart=/usr/local/libexec/tvguard/apply
# Fail safely: never flush other tables; a failure here leaves the rest running.
[Install]
WantedBy=multi-user.target
